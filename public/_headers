# Served by Cloudflare Workers static assets (copied to out/ by the build).
# https://developers.cloudflare.com/workers/static-assets/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  # MathLab loads nothing from other sites. The pages carry small inline scripts and styles
  # (Next.js hydration data, the language redirect), so those two need 'unsafe-inline'.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# File names under /_next/static/ contain a hash of their content, so they never change.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Pages must be checked again so a new deployment shows up at once.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
